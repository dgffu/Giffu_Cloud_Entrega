# ==========================================
# Giffu Entrega - Variáveis de Ambiente
# ==========================================

# Porta de execução do servidor
PORT=3000

# URL pública do aplicativo (usada nos callbacks do Google OAuth e links compartilhados)
# Exemplo: https://entrega.meudominio.com.br ou https://meu-app.railway.app
PUBLIC_URL=http://localhost:3000

# ------------------------------------------
# Google OAuth 2.0 (Google Cloud Console)
# ------------------------------------------
# Obtenha em: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# URI de Redirecionamento autorizada: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# Segurança e Criptografia
# ------------------------------------------
# Segredo para assinatura de cookies e sessões (mínimo de 32 caracteres aleatórios)
SESSION_SECRET=coloque_uma_frase_ou_hash_secreta_com_mais_de_32_caracteres_aqui

# Chave mestra para criptografar o banco de dados dos usuários (AES-256-GCM)
# Pode ser uma chave hexadecimal de 64 caracteres ou uma frase com mais de 16 caracteres
DATA_ENCRYPTION_KEY=

# (Opcional) Segredo para o cofre na nuvem dos tokens do Google Drive
CLOUD_VAULT_SECRET=

# ------------------------------------------
# Pastas de Armazenamento (opcionais, com fallback automático)
# ------------------------------------------
# DATA_DIR=/app/data
# CONFIG_DIR=/app/config

